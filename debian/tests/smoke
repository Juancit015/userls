#!/bin/sh
set -e

userls --version
userls --json | python3 -c 'import json, sys; data = json.load(sys.stdin); assert data["schema_version"] == 1'
userls --type normal --json >/dev/null
userls groups >/dev/null
userls sessions >/dev/null

test -f /usr/share/fish/vendor_completions.d/userls.fish
test -f /usr/share/bash-completion/completions/userls
test -f /usr/share/zsh/vendor-completions/_userls
